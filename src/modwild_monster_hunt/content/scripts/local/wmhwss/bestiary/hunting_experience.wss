
/// Represents the hunting experience for a single bestiary entry, that experience
/// can then be used to scale things when contracts or hunts are related to that
/// species.
class WMH_BestiaryEntryHuntingExperience {
  private var bestiary_entry_id: WMH_BestiaryId;
  private var facts: WMH_BestiaryEntryHuntingExperience_Facts;
  private var focus: WMH_BestiaryEntryHuntingExperience_HunterFocus;

  public function init(bentry_id: WMH_BestiaryId) {
    this.bestiary_entry_id = bentry_id;

    this.facts = new WMH_BestiaryEntryHuntingExperience_Facts in this;
    this.facts.init(bentry_id.value);

    this.focus = new WMH_BestiaryEntryHuntingExperience_HunterFocus in this;
    this.focus.init();
  }

  public function onClueInteracted() {
    this.facts.onClueInteracted();
    this.focus.onClueInteracted();
  }

  public function onContractCompleted(
    provider: WMH_RewardProvider,
    bentry: WMH_BestiaryEntry
  ) {
    provider.appendHuntingExperience(WMH_HuntingExperienceGain(bentry, 3));
    this.focus.onContractCompleted();
  }

  public function onRewardProviderGain(gain: int) {
    this.facts.setFactLevel(this.facts.getFactLevel() + gain);
  }

  public function onCreatureKilled(bentry: WMH_BestiaryEntry) {
    this.facts.onCreatureKilled();
    this.focus.onCreatureKilled();

    WMH_getHunterFocusManager()
      .onHuntingExperienceChanged(bentry);
  }

  private function getLevel(): float {
    return this.facts.getFactLevel() + this.getTemporaryHunterFocusLevel();
  }

  public function getTemporaryHunterFocusLevel(): int {
    return this.focus.getLevel();
  }

  public function getContractTargetOnelinerRenderDistanceBonus(): int {
    // rather simple at the moment: +1m for every level
    return FloorF(this.getLevel() * 1.0);
  }

  public function getCustomLootMultipler(): int {
    return 1 + FloorF(this.getLevel() / 30.0);
  }
}

class WMH_BestiaryEntryHuntingExperience_Facts {
  private var id: int;

  public function init(id: int)  {
    this.id = id;
  }

  public function factKey(): string {
    return "WMH_BestiaryEntryHuntingExperience_" + this.id;
  }

  public function getFactLevel(): int {
    return FactsQuerySum(this.factKey());
  }

  public function onClueInteracted() {
    this.setFactLevel(this.getFactLevel() + 1);
  }

  public function onCreatureKilled() {
    this.setFactLevel(this.getFactLevel() + 1);
  }



  private function setFactLevel(value: int) {
    FactsSet(this.factKey(), value);
  }
}

/// Temporary experience that lasts for a single hunt
class WMH_BestiaryEntryHuntingExperience_HunterFocus {
  private var level: int;

  public function init() {
    this.reset();
  }

  public function getLevel(): int {
    return this.level;
  }

  public function onClueInteracted() {
    this.increaseLevel(1);
  }

  public function onCreatureKilled() {
    this.increaseLevel(1);
  }

  public function onContractCompleted() {
    this.reset();
  }

  private function reset() {
    this.level = 0;
  }

  private function increaseLevel(gain: int) {
    this.level += 1;
  }
}

function WMH_getHunterFocusManager(): WMH_HunterFocusManager {
  return thePlayer.wmh.hunt.hunt_focus;
}

class WMH_HunterFocusManager {
  private var target: WMH_BestiaryEntry;
  private var oneliner_interaction: WMH_MovingGameplayOneliner;
  private var oneliner_focus_species: WMH_GameplayOnelinerHunterFocus;
  private var oneliner_hunting_experience: WMH_GameplayOnelinerHuntingExperienceGain;

  public function init(): WMH_HunterFocusManager {
    this.reset();

    return this;
  }

  public function onHuntStarted() {
    this.reset();
  }

  public function onHuntingExperienceChanged(bentry: WMH_BestiaryEntry) {
    this.spawnExperienceGainOneliner(bentry);

    if (this.setFocusTargetIfHighLevelEnough(bentry.id)) {
      this.playFocusActivationEffect();
    }
  }

  private function spawnExperienceGainOneliner(bentry: WMH_BestiaryEntry) {
    if (this.oneliner_hunting_experience) {
      this.oneliner_hunting_experience.unregister();
    }

    this.oneliner_hunting_experience = new WMH_GameplayOnelinerHuntingExperienceGain(
      bentry.getLocName()
    ) in this;
    this.oneliner_hunting_experience.register();
  }

  public function onClueInteracted(position: Vector) {
    if (!this.oneliner_interaction) {
      this.oneliner_interaction = new WMH_MovingGameplayOneliner in this;
      this.oneliner_interaction.translation_per_tick = Vector(0, 0, 0.05);
      this.oneliner_interaction.visible_outside_focus_mode = true;
      this.oneliner_interaction.register();
    }

    this.oneliner_interaction.position = position;
  }

  public function hasFocusTarget(): bool {
    if (this.target) {
      return true;
    }

    return false;
  }

  public isFocusTarget(bentry_id: WMH_BestiaryId): bool {
    return this.hasFocusTarget()
        && this.target.id == bentry_id;
  }

  private function setFocusTargetIfHighLevelEnough(
    bentry_id: WMH_BestiaryId
  ): bool {
    var bestiary: WMH_Bestiary = WMH_getBestiary();

    if (this.hasFocusTarget()) {
      if (this.target.id == bentry_id) {
        return false;
      }
    }

    for bentry: WMH_BestiaryEntry in bestiary.entries {
      if (bentry.id != bentry_id) {
        continue;
      }

      var level: int = bentry.hunting_experience.getTemporaryHunterFocusLevel();
      if (level < 3) {
        continue;
      }

      this.target = bentry;
      return true;
    }

    return false;
  }

  private function reset() {
    this.target = NULL;
  }

  private playFocusActivationEffect() {
    theSound.SoundEvent('expl_focus_stop_sfx');
    this.spawnFocusSpeciesOneliner();
  }

  private function spawnFocusSpeciesOneliner() {
    if (this.oneliner_focus_species) {
      this.oneliner_focus_species.unregister();
    }

    this.oneliner_focus_species = new WMH_GameplayOnelinerHunterFocus(
      this.target.getLocName()
    ) in this;
    this.oneliner_focus_species.register();
  }
}
