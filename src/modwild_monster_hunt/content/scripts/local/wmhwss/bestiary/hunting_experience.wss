
/// Represents the hunting experience for a single bestiary entry, that experience
/// can then be used to scale things when contracts or hunts are related to that
/// species.
class WMH_BestiaryEntryHuntingExperience {
  private var bestiary_entry_id: WMH_BestiaryId;
  private var facts: WMH_BestiaryEntryHuntingExperience_Facts;
  private var focus: WMH_BestiaryEntryHuntingExperience_HunterFocus;

  public function init(bentry_id: WMH_BestiaryId) {
    this.bestiary_entry_id = bentry_id;

    this.facts = new WMH_BestiaryEntryHuntingExperience_Facts in this;
    this.facts.init(bentry_id.value);

    this.focus = new WMH_BestiaryEntryHuntingExperience_HunterFocus in this;
    this.focus.init();
  }

  public function onClueInteracted() {
    this.facts.onClueInteracted();
    this.focus.onClueInteracted();
  }

  public function onContractCompleted(
    provider: WMH_RewardProvider,
    bentry: WMH_BestiaryEntry
  ) {
    provider.appendHuntingExperience(WMH_HuntingExperienceGain(bentry, 3));
    this.focus.onContractCompleted();
  }

  public function onRewardProviderGain(gain: int) {
    this.facts.setFactLevel(this.facts.getFactLevel() + gain);
  }

  private function getLevel(): float {
    return this.facts.getFactLevel() + this.focus.getLevel();
  }

  public function getContractTargetOnelinerRenderDistanceBonus(): int {
    // rather simple at the moment: +1m for every level
    return FloorF(this.getLevel() * 1.0);
  }

  public function getCustomLootMultipler(): int {
    return 1 + FloorF(this.getLevel() / 30.0);
  }
}

class WMH_BestiaryEntryHuntingExperience_Facts {
  private var id: int;

  public function init(id: int)  {
    this.id = id;
  }

  public function factKey(): string {
    return "WMH_BestiaryEntryHuntingExperience_" + this.id;
  }

  public function getFactLevel(): int {
    return FactsQuerySum(this.factKey());
  }

  public function onClueInteracted() {
    this.setFactLevel(this.getFactLevel() + 1);
  }



  private function setFactLevel(value: int) {
    FactsSet(this.factKey(), value);
  }
}

/// Temporary experience that lasts for a single hunt
class WMH_BestiaryEntryHuntingExperience_HunterFocus {
  private var level;

  public function init() {
    this.reset();
  }

  public function getLevel(): int {
    return this.level;
  }

  public function onClueInteracted() {
    this.increaseLevel(1);
  }

  public function onContractCompleted() {
    this.reset();
  }

  private function reset() {
    this.level = 0;
  }

  private function increaseLevel(gain: int) {
    this.level += 1;
  }
}