/// Base class for oneliners that need a common set of settings for gameplay
/// 3D markers.
class WMH_GameplayOneliner extends SU_Oneliner {
  public var visible_outside_focus_mode: bool;

  function getVisible(player_position: Vector): bool {
    return (this.visible_outside_focus_mode || theGame.IsFocusModeActive())
        && super.getVisible(player_position);
  }
}

class WMH_GameplayOnelinerEntity extends SU_OnelinerEntity {
  public var visible_outside_focus_mode: bool;

  function getVisible(player_position: Vector): bool {
    return (this.visible_outside_focus_mode || theGame.IsFocusModeActive())
        && super.getVisible(player_position);
  }
}

/// A gameplay oneliner that drifts from its initial position, the drift is
/// applied as translation_per_tick added to the offset every time the position
/// is computed.
class WMH_MovingGameplayOneliner extends WMH_GameplayOneliner {
  public var translation_per_tick: Vector;

  function getPosition(): Vector {
    this.offset = this.offset + this.translation_per_tick;

    return this.position + this.offset;
  }
}

/// A gameplay oneliner that shows a hunting experience gain, popping up in
/// front of where the player is looking.
class WMH_GameplayOnelinerHuntingExperienceGain extends WMH_MovingGameplayOneliner {
  public function WMH_GameplayOnelinerHuntingExperienceGain(
  ): WMH_GameplayOnelinerHuntingExperienceGain {
    this.text = "+1";
    this.translation_per_tick = Vector(0, 0, 0.01);
    this.visible_outside_focus_mode = true;
    this.position = thePlayer.GetWorldPosition()
      + theCamera.GetCameraDirection() * 2.0
      + Vector(0, 0, 1.5);

    return this;
  }
}

/// A oneliner that sits to the side of an entity
class WMH_GameplayOnelinerEntitySide extends WMH_GameplayOnelinerEntity {
  public function WMH_OnelinerEntitySide(
    entity: CEntity
  ): WMH_GameplayOnelinerEntitySide {
    // this won't work as well unless the offset is relative to the entity's
    // rotation. Could use the same technique as the board's OLs with a matrix.
    this.offset = Vector(1.0);

    return this;
  }
}

function WMH_gameplayOneliner(
  text: string,
  position: Vector
): WMH_GameplayOneliner {
  var oneliner: WMH_GameplayOneliner;

  oneliner = new WMH_GameplayOneliner in thePlayer;
  oneliner.text = text;
  oneliner.position = position;
  oneliner.register();

  return oneliner;
}

function WMH_movingGameplayOneliner(
  text: string,
  position: Vector
): WMH_MovingGameplayOneliner {
  var oneliner: WMH_MovingGameplayOneliner;

  oneliner = new WMH_MovingGameplayOneliner in thePlayer;
  oneliner.text = text;
  oneliner.position = position;
  oneliner.register();

  return oneliner;
}

function WMH_gameplayOnelinerEntity(
  text: string,
  entity: CEntity
): WMH_GameplayOnelinerEntity {
  var oneliner: WMH_GameplayOnelinerEntity;

  oneliner = new WMH_GameplayOnelinerEntity in thePlayer;
  oneliner.text = text;
  oneliner.entity = entity;
  oneliner.register();

  return oneliner;
}
